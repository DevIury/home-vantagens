---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Floats from '../components/Floats.astro';

const {
  title,
  description,
  path = '/',
  ogImage = 'https://www.homevantagens.com.br/blog/og-home-vantagens.png',
  active = null,
  dark = true,
} = Astro.props;
const canonical = 'https://www.homevantagens.com.br' + path;
---
<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="author" content="Home Vantagens">
    <meta name="theme-color" content="#051329">
        <link rel="icon" type="image/png" sizes="64x64" href="data:image/png;base64,">
        <link rel="apple-touch-icon" href="data:image/png;base64,">
    <link rel="canonical" href={canonical}>
    <link rel="alternate" hreflang="pt-BR" href={canonical}>

    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="Home Vantagens">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <!-- Tailwind CSS (CDN, mesma configuração do site original) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans, Newsreader, JetBrains Mono & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        alabaster: '#F6F5F1',
                        paper: '#EAE8E1',
                        hv: {
                            navy: '#051329',
                            navyMid: '#081F44',
                            navyLight: '#13315C',
                            orange: '#F36B21',
                            orangeBright: '#FF6B00',
                            orangeHover: '#D9560F',
                            border: '#DCD9D0',
                            slate: '#4A5262',
                            emerald: '#0D7A5F'
                        }
                    },
                    fontFamily: {
                        display: ['"Plus Jakarta Sans"', 'sans-serif'],
                        serif: ['"Newsreader"', 'Georgia', 'serif'],
                        sans: ['"Inter"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    }
                }
            }
        }
    </script>

    <slot name="head" />
</head>
<body class="font-sans antialiased selection:bg-hv-navy selection:text-white min-h-screen flex flex-col">
    <Header active={active} dark={dark} />
    <main class="flex-grow"><slot /></main>
    <Footer />
    <Floats />
    <script>
        // Interações gerais: menu mobile + acordeão FAQ (só no navegador)
        import '../scripts/site.js';
    </script>
</body>
</html>
