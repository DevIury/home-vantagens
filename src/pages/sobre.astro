---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title={'Sobre a Home Vantagens | Corretora de Seguros e Assessoria Multimercado'} description={'Conheça a Home Vantagens: corretora de seguros e assessoria multimercado com atuação em planos de saúde, proteção veicular, seguro de carro e consórcio. Missão, valores, método de cotação e governança regulatória.'} path="/sobre" active="sobre" dark={true}>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline>
    {
        "@context": "https://schema.org",
        "@type": "AboutPage",
        "name": "Sobre a Home Vantagens",
        "url": "https://www.homevantagens.com.br/sobre",
        "inLanguage": "pt-BR",
        "description": "Corretora de seguros e assessoria multimercado: missão, valores, método de cotação e governança regulatória.",
        "mainEntity": {
            "@type": "Organization",
            "name": "Home Vantagens",
            "url": "https://www.homevantagens.com.br/",
            "description": "Corretora de seguros e correspondente bancário atuando em planos de saúde, proteção veicular, seguro de carro e consórcio ou financiamento.",
            "areaServed": "BR",
            "knowsLanguage": "pt-BR"
        }
    }
    </script>
    </Fragment>
    
        <!-- ================= HERO ================= -->
        <section class="bg-hv-navy text-white pt-14 pb-16 lg:pt-20 lg:pb-24 border-b border-white/10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center gap-2 text-xs font-mono text-white/55 mb-5">
                    <a href="/" class="hover:text-white">Início</a>
                    <span>/</span>
                    <span class="text-hv-orange">Sobre</span>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
                    <div class="lg:col-span-7 space-y-5">
                        <h1 class="font-display font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-editorial leading-[1.05]">
                            Proteção sob medida,<br class="hidden sm:block"> com transparência<br class="hidden sm:block"> em cada escolha.
                        </h1>
                        <p class="text-white/70 text-base sm:text-lg leading-relaxed max-w-2xl">
                            A <strong class="text-white">Home Vantagens</strong> é uma corretora de seguros e assessoria multimercado. Comparamos planos de saúde, proteções veiculares, seguros de carro e consórcios entre as principais instituições do país — sem custo para o cliente e sem letras miúdas.
                        </p>
                        <div class="flex flex-wrap gap-3 pt-1">
                            <a href="https://wa.me/5500000000000?text=Ol%C3%A1%2C%20vim%20pelo%20site%20institucional%20da%20Home%20Vantagens." target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-3 h-12 px-7 rounded-xl bg-hv-orange text-white font-display font-bold text-sm hover:bg-hv-orangeHover transition-colors">
                                <span>Falar com um consultor</span>
                                <i class="fa-brands fa-whatsapp text-lg text-white"></i>
                            </a>
                            <a href="#metodo" class="btn-secondary-dark inline-flex items-center gap-3 h-12 px-7 rounded-xl border border-white/25 text-white font-display font-bold text-sm transition-colors">
                                <span>Como trabalhamos</span>
                                <i class="fa-solid fa-arrow-down text-xs text-hv-orange"></i>
                            </a>
                        </div>
                    </div>

                    <div class="lg:col-span-5">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="rounded-2xl bg-white/[0.05] border border-white/10 p-5">
                                <span class="font-mono text-2xl font-bold text-hv-orange">8+</span>
                                <p class="text-[11.5px] text-white/60 leading-snug mt-1.5">Instituições parceiras consultadas em cada cotação</p>
                            </div>
                            <div class="rounded-2xl bg-white/[0.05] border border-white/10 p-5">
                                <span class="font-mono text-2xl font-bold text-hv-orange">04</span>
                                <p class="text-[11.5px] text-white/60 leading-snug mt-1.5">Linhas de proteção: saúde, veicular, auto e consórcio</p>
                            </div>
                            <div class="rounded-2xl bg-white/[0.05] border border-white/10 p-5">
                                <span class="font-mono text-2xl font-bold text-hv-orange">R$ 0</span>
                                <p class="text-[11.5px] text-white/60 leading-snug mt-1.5">Taxa de assessoria cobrada do cliente</p>
                            </div>
                            <div class="rounded-2xl bg-white/[0.05] border border-white/10 p-5">
                                <span class="font-mono text-2xl font-bold text-hv-orange">100%</span>
                                <p class="text-[11.5px] text-white/60 leading-snug mt-1.5">Digital, do diagnóstico à assinatura da proposta</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= QUEM SOMOS + MISSÃO, VISÃO E VALORES ================= -->
        <section class="py-16 lg:py-24 bg-white border-b border-hv-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <div class="lg:col-span-6 space-y-5">
                        <span class="text-xs font-mono font-semibold uppercase tracking-[0.18em] text-hv-orange block">Nossa essência</span>
                        <h2 class="font-display font-bold text-3xl sm:text-4xl text-hv-navy tracking-editorial leading-tight">
                            Uma corretora construída para comparar, explicar e proteger.
                        </h2>
                        <div class="space-y-4 text-sm sm:text-base text-hv-slate leading-relaxed">
                            <p>
                                Escolher um plano de saúde, uma cobertura veicular ou um consórcio costuma ser confuso: dezenas de tabelas, carências, exclusões e letras pequenas. A Home Vantagens existe para transformar essa decisão em algo simples — <strong class="text-hv-navy">você compara, entende e escolhe com calma</strong>.
                            </p>
                            <p>
                                Atuamos como corretora de seguros e correspondente bancário, intermediando propostas junto a operadoras registradas na ANS, seguradoras autorizadas pela SUSEP e instituições financeiras homologadas pelo Banco Central do Brasil. Não vendemos um produto único: nossa obrigação é com a sua decisão.
                            </p>
                            <p>
                                Todo o atendimento é feito por consultores humanos, no WhatsApp, com comparativo claro de mensalidade, cobertura, carências e exclusões antes de qualquer assinatura.
                            </p>
                        </div>
                        <div class="flex flex-wrap gap-2 pt-1">
                            <span class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold uppercase tracking-wider text-hv-navy bg-alabaster border border-hv-border px-3 py-1.5 rounded-full"><i class="fa-solid fa-circle-check text-hv-orange"></i> SUSEP</span>
                            <span class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold uppercase tracking-wider text-hv-navy bg-alabaster border border-hv-border px-3 py-1.5 rounded-full"><i class="fa-solid fa-circle-check text-hv-orange"></i> ANS</span>
                            <span class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold uppercase tracking-wider text-hv-navy bg-alabaster border border-hv-border px-3 py-1.5 rounded-full"><i class="fa-solid fa-circle-check text-hv-orange"></i> Banco Central</span>
                            <span class="inline-flex items-center gap-2 text-[11px] font-mono font-semibold uppercase tracking-wider text-hv-navy bg-alabaster border border-hv-border px-3 py-1.5 rounded-full"><i class="fa-solid fa-circle-check text-hv-orange"></i> LGPD</span>
                        </div>
                    </div>

                    <div class="lg:col-span-6 space-y-4">
                        <div class="rounded-2xl bg-alabaster border border-hv-border p-7 space-y-2.5">
                            <div class="flex items-center gap-3">
                                <span class="w-9 h-9 rounded-xl bg-hv-orange/15 text-hv-orange flex items-center justify-center"><i class="fa-solid fa-bullseye text-hv-orange"></i></span>
                                <h3 class="font-display font-bold text-lg text-hv-navy">Missão</h3>
                            </div>
                            <p class="text-sm text-hv-slate leading-relaxed">
                                Simplificar a escolha de proteção — saúde, veículo e patrimônio — com informação clara, comparação honesta e acompanhamento humano do diagnóstico à ativação da cobertura.
                            </p>
                        </div>

                        <div class="rounded-2xl bg-alabaster border border-hv-border p-7 space-y-2.5">
                            <div class="flex items-center gap-3">
                                <span class="w-9 h-9 rounded-xl bg-hv-orange/15 text-hv-orange flex items-center justify-center"><i class="fa-solid fa-eye text-hv-orange"></i></span>
                                <h3 class="font-display font-bold text-lg text-hv-navy">Visão</h3>
                            </div>
                            <p class="text-sm text-hv-slate leading-relaxed">
                                Ser a referência nacional em assessoria multimercado digital: o ponto de partida de qualquer família ou empresa antes de contratar um plano, uma apólice ou uma carta de crédito.
                            </p>
                        </div>

                        <div class="rounded-2xl bg-hv-navy text-white p-7 space-y-3">
                            <div class="flex items-center gap-3">
                                <span class="w-9 h-9 rounded-xl bg-white/10 text-hv-orange flex items-center justify-center"><i class="fa-solid fa-scale-balanced text-hv-orange"></i></span>
                                <h3 class="font-display font-bold text-lg">Valores</h3>
                            </div>
                            <ul class="space-y-2 text-sm text-white/75">
                                <li class="flex items-start gap-2.5"><span class="font-mono text-[11px] text-hv-orange pt-0.5">01</span><span><strong class="text-white">Transparência total</strong> — condições inteiras apresentadas antes da contratação.</span></li>
                                <li class="flex items-start gap-2.5"><span class="font-mono text-[11px] text-hv-orange pt-0.5">02</span><span><strong class="text-white">Independência</strong> — comparamos o mercado, não empurramos um produto.</span></li>
                                <li class="flex items-start gap-2.5"><span class="font-mono text-[11px] text-hv-orange pt-0.5">03</span><span><strong class="text-white">Sigilo</strong> — dados tratados conforme a LGPD, sem repasse indevido.</span></li>
                                <li class="flex items-start gap-2.5"><span class="font-mono text-[11px] text-hv-orange pt-0.5">04</span><span><strong class="text-white">Presença</strong> — o mesmo consultor acompanha cotação, contratação e sinistro.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= MÉTODO EM 4 ETAPAS ================= -->
        <section id="metodo" class="py-16 lg:py-24 bg-alabaster border-b border-hv-border scroll-mt-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-3xl mb-12">
                    <span class="text-xs font-mono font-semibold uppercase tracking-[0.18em] text-hv-orange block mb-2">
                        Metodologia exclusiva Home Vantagens
                    </span>
                    <h2 class="font-display font-bold text-3xl sm:text-4xl text-hv-navy tracking-editorial">
                        Como funciona nossa mesa de cotação, em 4 etapas
                    </h2>
                    <p class="text-hv-slate text-sm sm:text-base leading-relaxed mt-4">
                        O mesmo processo para qualquer linha de produto — do primeiro diagnóstico ao acompanhamento depois da contratação.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="p-7 rounded-2xl bg-white border border-hv-border space-y-3">
                        <span class="font-mono text-xs font-bold text-hv-orange">ETAPA 01</span>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Diagnóstico do perfil</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">
                            Entendemos o que precisa ser protegido: saúde da família, veículo de uso particular ou comercial, ou um projeto de compra.
                        </p>
                    </div>
                    <div class="p-7 rounded-2xl bg-white border border-hv-border space-y-3">
                        <span class="font-mono text-xs font-bold text-hv-orange">ETAPA 02</span>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Cotação em 8+ parceiros</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">
                            Consultamos operadoras de saúde, seguradoras e administradoras de consórcio homologadas para achar o melhor custo-benefício.
                        </p>
                    </div>
                    <div class="p-7 rounded-2xl bg-white border border-hv-border space-y-3">
                        <span class="font-mono text-xs font-bold text-hv-orange">ETAPA 03</span>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Apresentação transparente</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">
                            O comparativo chega pelo WhatsApp: mensalidade, coberturas, carências e exclusões, sem letras miúdas.
                        </p>
                    </div>
                    <div class="p-7 rounded-2xl bg-white border border-hv-border space-y-3">
                        <span class="font-mono text-xs font-bold text-hv-orange">ETAPA 04</span>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Contratação e acompanhamento</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">
                            Assinatura digital no ambiente oficial da operadora, com suporte na ativação e em eventuais acionamentos.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= O QUE OFERECEMOS ================= -->
        <section class="py-16 lg:py-24 bg-white border-b border-hv-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
                    <div class="max-w-2xl">
                        <span class="text-xs font-mono font-semibold uppercase tracking-[0.18em] text-hv-orange block mb-2">Frentes de atuação</span>
                        <h2 class="font-display font-bold text-3xl sm:text-4xl text-hv-navy tracking-editorial">
                            Quatro linhas, um mesmo padrão de cuidado
                        </h2>
                    </div>
                    <a href="/solucoes" class="inline-flex items-center gap-2 text-xs font-display font-bold uppercase tracking-wider text-hv-navy hover:text-hv-orange transition-colors whitespace-nowrap">
                        <span>Ver todas as soluções</span>
                        <i class="fa-solid fa-arrow-right text-hv-orange"></i>
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <a href="/solucoes#saude" class="group p-7 rounded-2xl bg-alabaster border border-hv-border space-y-3 hover:border-hv-orange hover:-translate-y-1 transition-all duration-200">
                        <div class="flex items-center justify-between">
                            <span class="w-10 h-10 rounded-xl bg-hv-orange/15 text-hv-orange flex items-center justify-center"><i class="fa-solid fa-heart-pulse text-hv-orange"></i></span>
                            <span class="font-mono text-[11px] text-white/0 group-hover:text-hv-orange transition-colors">01</span>
                        </div>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Planos de Saúde</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">Mensalidade fixa a partir de R$ 45, com reembolso de medicamentos e exames, para você, sua família ou sua empresa.</p>
                        <span class="inline-flex items-center gap-2 text-[11px] font-display font-bold uppercase tracking-wider text-hv-orange">Saiba mais <i class="fa-solid fa-arrow-right text-[9px] text-hv-orange"></i></span>
                    </a>

                    <a href="/solucoes#protecao" class="group p-7 rounded-2xl bg-alabaster border border-hv-border space-y-3 hover:border-hv-orange hover:-translate-y-1 transition-all duration-200">
                        <div class="flex items-center justify-between">
                            <span class="w-10 h-10 rounded-xl bg-hv-orange/15 text-hv-orange flex items-center justify-center"><i class="fa-solid fa-shield-halved text-hv-orange"></i></span>
                            <span class="font-mono text-[11px] text-white/0 group-hover:text-hv-orange transition-colors">02</span>
                        </div>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Proteção Veicular</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">Roubo, colisão, incêndio e assistência 24h com avaliação de guincho, carro reserva e valor a preço de tabela.</p>
                        <span class="inline-flex items-center gap-2 text-[11px] font-display font-bold uppercase tracking-wider text-hv-orange">Saiba mais <i class="fa-solid fa-arrow-right text-[9px] text-hv-orange"></i></span>
                    </a>

                    <a href="/solucoes#auto" class="group p-7 rounded-2xl bg-alabaster border border-hv-border space-y-3 hover:border-hv-orange hover:-translate-y-1 transition-all duration-200">
                        <div class="flex items-center justify-between">
                            <span class="w-10 h-10 rounded-xl bg-hv-orange/15 text-hv-orange flex items-center justify-center"><i class="fa-solid fa-car-side text-hv-orange"></i></span>
                            <span class="font-mono text-[11px] text-white/0 group-hover:text-hv-orange transition-colors">03</span>
                        </div>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Seguro de Carro</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">Cotação em poucos minutos entre várias seguradoras, com simulação de franquia e pacote de coberturas.</p>
                        <span class="inline-flex items-center gap-2 text-[11px] font-display font-bold uppercase tracking-wider text-hv-orange">Saiba mais <i class="fa-solid fa-arrow-right text-[9px] text-hv-orange"></i></span>
                    </a>

                    <a href="/solucoes#consorcio" class="group p-7 rounded-2xl bg-alabaster border border-hv-border space-y-3 hover:border-hv-orange hover:-translate-y-1 transition-all duration-200">
                        <div class="flex items-center justify-between">
                            <span class="w-10 h-10 rounded-xl bg-hv-orange/15 text-hv-orange flex items-center justify-center"><i class="fa-solid fa-building-columns text-hv-orange"></i></span>
                            <span class="font-mono text-[11px] text-white/0 group-hover:text-hv-orange transition-colors">04</span>
                        </div>
                        <h3 class="font-display font-bold text-lg text-hv-navy">Consórcio &amp; Financiamento</h3>
                        <p class="text-xs text-hv-slate leading-relaxed">Cartas de crédito e crédito direto comparados lado a lado: taxa de administração, prazo e custo efetivo.</p>
                        <span class="inline-flex items-center gap-2 text-[11px] font-display font-bold uppercase tracking-wider text-hv-orange">Saiba mais <i class="fa-solid fa-arrow-right text-[9px] text-hv-orange"></i></span>
                    </a>
                </div>
            </div>
        </section>

        <!-- ================= GOVERNANÇA ================= -->
        <section class="py-16 lg:py-24 bg-alabaster border-b border-hv-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                    <div class="lg:col-span-6 bg-white p-8 sm:p-10 rounded-2xl border border-hv-border space-y-5">
                        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-hv-navy bg-paper px-3 py-1 rounded">
                            <i class="fa-solid fa-building-columns text-hv-orange"></i>
                            <span>SUSEP • ANS • BANCO CENTRAL</span>
                        </div>
                        <h3 class="font-display font-bold text-2xl text-hv-navy">Enquadramento legal e certificações</h3>
                        <p class="text-sm text-hv-slate leading-relaxed">
                            A Home Vantagens atua como corretora de seguros e correspondente bancário, estritamente dentro das normas da SUSEP, da ANS e do Banco Central do Brasil. Nossos especialistas passam por certificação técnica e seguem rigorosamente a LGPD no tratamento dos seus dados.
                        </p>
                        <ul class="space-y-2.5 text-xs sm:text-sm text-hv-navy font-medium pt-2">
                            <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-hv-orange"></i><span>Respeito integral às regras de precificação e reajuste da ANS</span></li>
                            <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-hv-orange"></i><span>Intermediação sem cobrança de taxas de assessoria ao cliente</span></li>
                            <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-hv-orange"></i><span>Sigilo e criptografia ponta a ponta de documentos (LGPD)</span></li>
                            <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-hv-orange"></i><span>Nenhum pagamento antecipado para aprovação ou liberação de cobertura</span></li>
                        </ul>
                        <a href="/institucional" class="inline-flex items-center gap-2 text-xs font-display font-bold uppercase tracking-wider text-hv-navy hover:text-hv-orange transition-colors">
                            <span>Ver protocolo antifraude completo</span>
                            <i class="fa-solid fa-arrow-right text-hv-orange"></i>
                        </a>
                    </div>

                    <div class="lg:col-span-6 bg-hv-navy text-white p-8 sm:p-10 rounded-2xl space-y-5">
                        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-hv-orange bg-white/10 px-3 py-1 rounded">
                            <i class="fa-solid fa-handshake text-hv-orange"></i>
                            <span>POR QUE FALAR COM CORRETORA</span>
                        </div>
                        <h3 class="font-display font-bold text-2xl">Você não paga a mais por comparar</h3>
                        <div class="space-y-3.5 text-sm">
                            <div class="p-4 rounded-xl bg-hv-navyMid border border-white/10">
                                <strong class="text-hv-orange block mb-1">Uma conversa, várias instituições</strong>
                                <span class="text-white/70">Em vez de abrir simulação em cada banco, operadora e seguradora, você descreve o perfil uma vez e recebe o comparativo pronto.</span>
                            </div>
                            <div class="p-4 rounded-xl bg-hv-navyMid border border-white/10">
                                <strong class="text-hv-orange block mb-1">Leitura das letras miúdas</strong>
                                <span class="text-white/70">Carências, exclusões, limite de sinistro e reajuste são traduzidos para português antes de você assinar.</span>
                            </div>
                            <div class="p-4 rounded-xl bg-hv-navyMid border border-white/10">
                                <strong class="text-hv-orange block mb-1">Acompanhamento depois da compra</strong>
                                <span class="text-white/70">Mesmo consultor para emissão, ativação, mudança de cobertura e apoio em acionamentos.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= CTA ================= -->
        <section class="bg-hv-navy text-white py-16 lg:py-24">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
                <span class="text-xs font-mono font-semibold uppercase tracking-[0.18em] text-hv-orange">Próximo passo</span>
                <h2 class="font-display font-extrabold text-3xl sm:text-5xl tracking-editorial leading-tight">
